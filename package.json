{
  "name": "huishouden-tasks",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "tsc --noEmit",
    "test": "vitest run test/unit",
    "e2e": "PW_LIVE_ONLY=1 playwright test --project=live",
    "e2e:ai": "PW_AI=1 playwright test --project=ai",
    "verify": "bun run lint && bunx pwa-design-check && bun run test && vite build",
    "e2e:local": "playwright test --project=local",
    "prepare": "git config core.hooksPath .githooks || true",
    "icons": "pwa-logo check public/icon.svg && pwa-icons --background=#1b4332",
    "e2e:signed-in": "PW_LIVE_ONLY=1 playwright test --project=signed-in",
    "screenshots": "PW_LIVE_ONLY=1 playwright test --project=screenshots"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^12.19.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@huishouden/pwa-kit": "github:huishouden/pwa-kit#v0.38.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
